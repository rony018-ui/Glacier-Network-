{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with academic role and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["professor", "researcher", "student", "independent", "institution"] },
        "institutionId": { "type": "string" },
        "institutionName": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500 },
        "impactPoints": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Research mission or impact project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "institutionName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "sdg": { "type": "string", "maxLength": 50 },
        "goalAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "description"]
    },
    "Discussion": {
      "title": "Discussion",
      "description": "Nexus insight discussion thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "description"]
    },
    "ResearchTask": {
      "title": "ResearchTask",
      "description": "Mission task synced with Google Tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "missionId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["needsAction", "completed"] },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "ResearchEvent": {
      "title": "ResearchEvent",
      "description": "Symposium or sprint event synced with Google Calendar and Meet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "summary": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "location": { "type": "string", "maxLength": 200 },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "meetLink": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "summary", "start", "end"]
    },
    "ResearchStation": {
      "title": "ResearchStation",
      "description": "Geospatial telemetry and field station mapped globally",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "region": { "type": "string", "maxLength": 100 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "type": { "type": "string", "enum": ["mineralization", "ocean_buoy", "sensor_array", "direct_air_capture", "academic_lab"] },
        "status": { "type": "string", "enum": ["operational", "calibrating", "planned"] },
        "telemetryMetric": { "type": "string", "maxLength": 100 },
        "lastReading": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "lat", "lng", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles"
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Collection of research missions and campaigns"
    },
    "/discussions/{discussionId}": {
      "schema": { "$ref": "#/entities/Discussion" },
      "description": "Nexus insight discussion posts"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/ResearchTask" },
      "description": "Google Tasks synchronized research actions"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/ResearchEvent" },
      "description": "Google Calendar and Meet synchronized events"
    },
    "/stations/{stationId}": {
      "schema": { "$ref": "#/entities/ResearchStation" },
      "description": "Field research stations and telemetry sensors mapped geographically"
    }
  }
}
