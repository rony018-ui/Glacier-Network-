rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'sazzadhossin01682@gmail.com');
      allow delete: if false;
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
    }

    // Discussions collection
    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'sazzadhossin01682@gmail.com');
    }

    // Field Research Stations (Google Maps Grounding)
    match /stations/{stationId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
